# ── Database ───────────────────────────────────────────────────────────────
# Postgres in development and production alike. Locally: `docker compose up -d`.
# On Vercel: a Neon / Vercel Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/picklelounge"
# Used only by the integration tests, which truncate every table they touch.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/picklelounge_test"

# ── App ────────────────────────────────────────────────────────────────────
# Signs entry passes and staff sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every staff session and every issued pass.
APP_SECRET="replace-me-with-32-plus-random-bytes"
# Public origin, used to build pass links, join links and payment redirect URLs.
# On Vercel this can be left unset for a first deploy — the platform's own
# domain is used automatically. Set it once you have a custom domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── PayMongo (https://dashboard.paymongo.com/developers) ───────────────────
# Test keys start sk_test_ / pk_test_. Leave blank to run the built-in
# sandbox gateway instead: bookings still confirm, no money moves.
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
# From the webhook you create for checkout_session.payment.paid — starts whsk_.
PAYMONGO_WEBHOOK_SECRET=""

# ── Email (https://resend.com) ─────────────────────────────────────────────
# Leave blank to log passes to the server console instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="Pickle Lounge <passes@picklelounge.ph>"
